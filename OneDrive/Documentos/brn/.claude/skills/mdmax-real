#!/usr/bin/env python3
"""
MdMax Real Skill - Actually works
"""
import subprocess
import sys
import json
from pathlib import Path

def main():
    if len(sys.argv) < 2:
        print("Usage: mdmax-real <command> [args]")
        print("\nCommands:")
        print("  convert <file>     Convert file to Markdown")
        print("  dashboard          Show dashboard")
        print("  stats              Show statistics")
        print("  config             Show configuration")
        sys.exit(1)
    
    command = sys.argv[1]
    args = sys.argv[2:] if len(sys.argv) > 2 else []
    
    # Execute mdmax command
    try:
        result = subprocess.run(
            ["mdmax", command] + args,
            capture_output=True,
            text=True,
            timeout=30
        )
        
        print(result.stdout)
        if result.stderr:
            print(result.stderr, file=sys.stderr)
        
        sys.exit(result.returncode)
        
    except FileNotFoundError:
        print("❌ Error: mdmax not found. Install with: pip install mdmax")
        sys.exit(1)
    except Exception as e:
        print(f"❌ Error: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()
