{
  "default_mode": "ultra",
  "cache_cleanup_days": 7,
  "enable_logging": true,
  "log_level": "info",
  "parallelization": {
    "enabled": true,
    "workers": 3
  },
  "quality_thresholds": {
    "min_score": 70,
    "warn_compression": 5
  },
  "optimize_tokens": {
    "aggressive": true,
    "remove_metadata": true,
    "compress_tables": true
  },
  "supported_formats": [
    ".pdf",
    ".xlsx",
    ".xls",
    ".xlsm",
    ".csv",
    ".tsv",
    ".txt",
    ".json",
    ".ods",
    ".docx",
    ".pptx",
    ".svg",
    ".jpg",
    ".jpeg",
    ".png",
    ".epub"
  ]
}
